# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# Local MongoDB or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/ai-agent

# Frontend URL(s) allowed by CORS (comma-separated)
CLIENT_URL=http://localhost:5173

# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=7

# --- AI (Google Gemini, free tier) ---
# Free key (no card needed): https://aistudio.google.com/apikey
GEMINI_API_KEY=
APP_NAME=Doable
# Flash-Lite has the most generous free quota. Alternative: gemini-flash-latest (smarter, far fewer free requests/day)
LLM_MODEL=gemini-flash-lite-latest
LLM_MAX_TOKENS=8192
# Max chat messages per user per day — protects the free quota that all users share (0 = no limit)
DAILY_MESSAGE_LIMIT=40
# --- Google (Gmail / Calendar) --- see docs/GOOGLE_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud. In dev it goes through the Vite proxy.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/google/callback
# Encrypts OAuth tokens in MongoDB. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Cost control & admin ---
# Max estimated AI spend per user per month (USD). Admins can change it per user.
USER_MONTHLY_BUDGET_USD=5
# Model prices (USD per million tokens) used to estimate spend. 0 on the free tier;
# set real prices only if you switch to a paid Gemini key.
LLM_PRICE_INPUT=0
LLM_PRICE_OUTPUT=0
LLM_PRICE_CACHE_READ=0
LLM_PRICE_CACHE_WRITE=0
WEB_SEARCH_PRICE=0
# Comma-separated emails that become admins (can open /admin)
ADMIN_EMAILS=

# Let the agent search the web (Google Search grounding; each search uses one extra free-tier request)
ENABLE_WEB_SEARCH=true

# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# Local MongoDB or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/ai-agent

# Frontend URL(s) allowed by CORS (comma-separated)
CLIENT_URL=http://localhost:5173

# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=7

# --- AI (Claude) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
APP_NAME=Doable
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = smarter but slower/more tokens)
LLM_EFFORT=medium
LLM_MAX_TOKENS=64000
# --- Google (Gmail / Calendar) --- see docs/GOOGLE_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud. In dev it goes through the Vite proxy.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/google/callback
# Encrypts OAuth tokens in MongoDB. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Cost control & admin ---
# Max estimated AI spend per user per month (USD). Admins can change it per user.
USER_MONTHLY_BUDGET_USD=5
# Model prices (USD per million tokens) used to estimate spend. Defaults match Claude Opus 5.5.
LLM_PRICE_INPUT=4
LLM_PRICE_OUTPUT=20
LLM_PRICE_CACHE_READ=0.2
LLM_PRICE_CACHE_WRITE=5
WEB_SEARCH_PRICE=0.01
# Comma-separated emails that become admins (can open /admin)
ADMIN_EMAILS=

# Let the agent search the web for current information (each search is billed by Anthropic)
ENABLE_WEB_SEARCH=true
